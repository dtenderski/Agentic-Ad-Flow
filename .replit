modules = ["nodejs-20", "web", "bash", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-all.sh"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
META_PAGE_ID = "1213993801797459"
API_ACCESS_KEY = "8933299952b64ab2a008d99d9542a8cb"
EXPO_PUBLIC_API_ACCESS_KEY = "8933299952b64ab2a008d99d9542a8cb"
VITE_API_ACCESS_KEY = "8933299952b64ab2a008d99d9542a8cb"
